{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bhtelegram",
  "version": "0.4.1",
  "identifier": "com.llmaiboot.bhtelegram",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BhTelegram",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/.*/tdlib/photos/*",
          "**/.*/tdlib/stickers/*",
          "**/.*/tdlib/voice/*",
          "**/zk_plain/*/*",
          "**/.*/zk_plain/*/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}